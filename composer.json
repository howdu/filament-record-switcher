{
    "name": "howdu/filament-record-switcher",
    "description": "Resource level navigation with search",
    "keywords": [
        "howdu",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-record-switcher"
    ],
    "homepage": "https://github.com/howdu/filament-record-switcher",
    "support": {
        "issues": "https://github.com/howdu/filament-record-switcher/issues",
        "source": "https://github.com/howdu/filament-record-switcher"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ben",
            "email": "howdu3@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0 || ^5.0",
        "filament/forms": "^4.0 || ^5.0",
        "filament/schemas": "^4.0 || ^5.0",
        "filament/tables": "^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.15.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.5",
        "laravel/framework": "^12.61.1",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "sinnbeck/laravel-dom-assertions": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Howdu\\FilamentRecordSwitcher\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Howdu\\FilamentRecordSwitcher\\Tests\\": "tests/src",
            "Howdu\\FilamentRecordSwitcher\\Tests\\Database\\Factories\\": "tests/database/factories"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "test:lint": "pint --test",
        "format": "vendor/bin/pint",
        "preflight": [
            "@format",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Howdu\\FilamentRecordSwitcher\\FilamentRecordSwitcherServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
